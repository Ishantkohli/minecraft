        "import os\n",
        "#@markdown ####Path to all server files\n",
        "#@markdown ######omit / at the end\n",
        "SERVER_DIR= \"/content/drive/MyDrive/MCServer\" #@param {type:\"string\"}\n",
        "\n",
        "\n",
        "#Will remove and redownload server.jar to prevent errors\n",
        "%cd \"$SERVER_DIR\"\n",
        "!rm server.jar\n",
        "#@markdown ####Paste direct link for your server jar file below\n",
        "Link = 'https://download.getbukkit.org/spigot/spigot-1.18.jar' #@param {type:\"string\"}\n",
        "!wget -q --show-progress -O server.jar $Link\n",
        "\n",
        "#JAVA 16\n",
        "%cd /opt/\n",
        "!wget -q --show-progress  \"https://downloads.testersquad.ml/2:/openjdk17-openj9.tar.gz\"\n",
        "!tar xzf \"openjdk17-openj9.tar.gz\"\n",
        "!rm \"openjdk17-openj9.tar.gz\"\n",
        "%cd \"$SERVER_DIR\"\n",
        "\n",
        "\n",
        "#Configuring ngrok tunnels\n",
        "!pip install pyngrok --quiet\n",
        "from pyngrok import conf, ngrok\n",
        "from termcolor import colored\n",
        "\n",
        "# Terminate open tunnels if exist\n",
        "ngrok.kill()\n",
        "#@markdown #### Setting the authtoken\n",
        "#@markdown ######Get your authtoken from https://dashboard.ngrok.com/auth\n",
        "NGROK_AUTH_TOKEN = \"\" #@param {type:\"string\"}\n",
        "#@markdown #####Set the ngrok region nearest to you (check region codes at the bottom of this notebook)\n",
        "Region=\"in\" #@param {type:\"string\"}\n",
        "ngrok.set_auth_token(NGROK_AUTH_TOKEN)\n",
        "conf.get_default().region = Region\n",
        "\n",
        "\n",
        "#Open a TCP tunnel on port 25565 for Minecraft\n",
        "mc_url = ngrok.connect(25565, proto=\"tcp\", options={\"country\": \"in\"})\n",
        "ip = print(colored(\"Server IP for game:\", \"green\"), colored(mc_url, \"blue\"))\n",
        "print(colored(\"Omit tcp:// part when connecting \",\"green\"))\n",
        "\n",
        "\n",
        "# Open a HTTPs tunnel on port 8081 for Parrotpanel\n",
        "panel_url = ngrok.connect(8081, proto=\"http\", options={\"country\": \"in\"})\n",
        "console = print(colored(\"ParrotPanel address\",\"green\"), colored(panel_url, \"blue\"))\n",
        "\n",
        "## DISCORD WEBHOOK\n",
        "!pip install discord-webhook\n",
        "\n",
        "from discord_webhook import DiscordWebhook, DiscordEmbed\n",
        "#@markdown ##### Discord Webhook url\n",
        "WEBHOOK_URL = \"\" #@param {type:\"string\"}\n",
        "webhook = DiscordWebhook(url=WEBHOOK_URL)\n",
        "\n",
        "embed = DiscordEmbed(title='Server Status', description='such funny', color='03b2f8')\n",
        "embed.set_timestamp()\n",
        "embed.add_embed_field(name='Server IP', value=f\" * MC server at {mc_url}\")\n",
        "embed.add_embed_field(name='Console URL', value=f\" * Control Panel at {panel_url}\")\n",
        "webhook.add_embed(embed)\n",
        "response = webhook.execute()\n",
        "\n",
        "## STARTING SERVER\n",
        "\n",
        "print('Starting server now...')\n",
        "!/opt/jdk/bin/java -version\n",
        "!/opt/jdk/bin/java -Xmx10G -Xms128M -Dterminal.jline=false -Dterminal.ansi=true -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true -jar server.jar nogui\n"
